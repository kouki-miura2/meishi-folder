{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meishi-folder",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-11",
  "observability": {
    "enabled": true,
  },
  // The frontend (apps/frontend, built by `vp run frontend#build`) is served from the same origin.
  // Only /api/* runs the Worker; any other path is a static file, or index.html for the SPA's
  // own routes (/cards/..., /settings/...).
  "assets": {
    "directory": "../frontend/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  // IDs are left out on purpose: `wrangler deploy` provisions the D1 database and R2 bucket on
  // first deploy, and `wrangler dev` runs both locally.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "meishi-folder",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "meishi-folder-images",
    },
  ],
  // Workers AI has no local simulator: even `wrangler dev` calls the real (billed) service.
  "ai": {
    "binding": "AI",
    "remote": true,
  },
  // Daily at 03:00 JST: delete photos uploaded but never saved to a card (src/worker.ts `scheduled`).
  "triggers": {
    "crons": ["0 18 * * *"],
  },
  // Secrets, supplied via `.dev.vars` locally and `wrangler secret put <NAME>` in production:
  // - GOOGLE_CLIENT_ID: the OAuth client id that Google ID tokens must be issued for.
  // - SESSION_SECRET: the key that signs session cookies (32+ random characters, e.g.
  //   `openssl rand -base64 32`). Changing it signs everyone out.
}
